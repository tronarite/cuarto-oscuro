// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Privacy {
  PUBLIC
  UNLISTED
  PASSWORD
}

// Plantilla de cuadrícula fija: cada galería elige una y define el tamaño
// de cada hueco según la posición de la foto (patrón cíclico), en vez de
// marcar cada foto individualmente.
enum GalleryLayout {
  MIXED
  LARGE
  COMPACT
  BALANCED
}

// Paleta de color de toda la web, la fija el admin en Ajustes — las 4 son
// variaciones en blanco y negro (sin tintes de color), cada una con su
// propia versión clara y oscura; el botón de tema sigue alternando entre
// esas dos dentro del pack elegido.
enum ColorPack {
  WARM
  COOL
  CONTRAST
  SOFT
}

// Estilo de esquina de las miniaturas de fotos en toda la web, lo fija
// el admin en Ajustes — SQUARE (por defecto) recorta a esquina viva,
// ROUNDED redondea. Se aplica vía [data-photo-corner] en <html>.
enum PhotoCorner {
  ROUNDED
  SQUARE
}

// Fila única con los ajustes globales del sitio (marca de agua, etc.).
model Settings {
  id               Int     @id @default(1)
  watermarkEnabled Boolean @default(true)
  watermarkText    String  @default("© Galería fotográfica")

  // Contraseña del panel de administración (bcrypt). null = todavía sin
  // configurar: proxy.ts manda a /admin/setup para elegirla la primera
  // vez que se visita el sitio, en vez de venir fija por variable de
  // entorno.
  adminPasswordHash String?

  // Usuario del panel de administración, junto a la contraseña. null =
  // instalación todavía sin usuario fijado: loginAdmin sigue aceptando
  // solo la contraseña hasta que se rellene una vez desde Ajustes (ver
  // loginAdmin en admin/actions.ts).
  adminUsername String?

  // Título y subtítulo editables de la portada.
  siteTitle    String  @default("Galería fotográfica")
  siteSubtitle String?

  // Página "Sobre mí": texto y foto (procesada, sin marca de agua, sin
  // recortar — se guardan también sus dimensiones para poder maquetar
  // respetando su proporción real). aboutEnabled controla tanto el botón
  // de la portada como el acceso directo a /sobre-mi.
  aboutEnabled     Boolean @default(true)
  aboutText        String?
  aboutPhotoPath   String?
  aboutPhotoWidth  Int?
  aboutPhotoHeight Int?
  // Texto del botón/enlace de la portada hacia "Sobre mí" (el título de
  // la propia página se queda fijo, esto es solo la etiqueta del botón).
  aboutButtonLabel String @default("Sobre mí")

  colorPack   ColorPack   @default(WARM)
  photoCorner PhotoCorner @default(SQUARE)

  // BETA: al subir una foto, se manda a la API de Google Cloud Vision
  // (Web Detection — el mismo motor que usa images.google.com para
  // "buscar con esta imagen") para intentar identificarla; si hay un
  // resultado claro, se usa como pie de foto inicial. Necesita
  // GOOGLE_VISION_API_KEY en el entorno — sin esa variable, el
  // interruptor no hace nada aunque esté activado (ver src/lib/vision.ts).
  autoCaptionEnabled Boolean @default(false)
}

model Gallery {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String?

  privacy      Privacy       @default(PUBLIC)
  passwordHash String?
  layout       GalleryLayout @default(MIXED)

  visitCount Int @default(0)

  // Orden en el panel de admin y en la lista de la portada (arrastrar
  // para reordenar). No tiene por qué coincidir con createdAt.
  order Int @default(0)

  photos    Photo[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Photo {
  id       String @id @default(cuid())
  gallery  Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  galleryId String

  // Orden dentro de la galería (secuencia continua, sin salas). El tamaño
  // del hueco de cada foto se deriva de esta posición y de la plantilla
  // de la galería (Gallery.layout), no se marca por foto.
  order Int

  // Rutas a los archivos procesados (con watermark, varias resoluciones).
  // El original sin marca se guarda aparte y nunca se expone vía app.
  originalPath String
  displayPath  String
  thumbPath    String?

  // Dimensiones de la imagen procesada (ya orientada según EXIF), para
  // poder maquetar en mosaico respetando la proporción real de cada foto.
  width  Int?
  height Int?

  description String?

  // BETA: true si `description` la puso la identificación automática
  // (ver src/lib/vision.ts), false si la escribió el admin a mano (o si
  // no tiene pie de foto todavía). Así el botón "Identificar fotos ya
  // subidas" puede regenerar/sobreescribir sus propios resultados
  // anteriores sin arriesgar nunca un pie de foto escrito a mano:
  // updatePhotoDescription (el campo de texto del admin) siempre lo pone
  // a false en cuanto se edita manualmente.
  descriptionAutoGenerated Boolean @default(false)

  // Hasta 3 por galería (impuesto en la acción, no en el esquema): son
  // las que se muestran en el raíl de la portada.
  homeFeatured Boolean @default(false)

  // Índice fijo (0-based) que esta foto debe ocupar en la secuencia
  // mostrada, sin importar qué se borre o reordene alrededor. null =
  // sin anclar (sigue el orden normal por `order`). Se calcula al anclar
  // y no se toca hasta desanclar; ver src/lib/photo-order.ts.
  pinnedPosition Int?

  // SHA-256 del archivo original: evita subir la misma foto dos veces a
  // la misma galería.
  contentHash String

  // EXIF
  cameraMake   String?
  cameraModel  String?
  lens         String?
  iso          Int?
  aperture     Float?
  shutterSpeed String?
  focalLength  Float?

  // GPS
  latitude  Float?
  longitude Float?

  takenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([galleryId, order])
  @@unique([galleryId, contentHash])
}
