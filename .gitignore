# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma / sqlite
/dev.db
*.db
*.db-journal
/src/generated/prisma

# uploads (fotos originales y procesadas, nunca al repo)
/uploads

# copias de seguridad generadas por scripts/backup.*
/backups

# skills de asistentes de IA (documentación de referencia instalada por
# herramientas de desarrollo, no forma parte del proyecto)
/.agents
/.claude/skills
/.windsurf
/skills-lock.json
