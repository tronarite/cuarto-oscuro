# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="file:./dev.db"

# La contraseña del panel de administración ya no se fija aquí: se
# configura desde /admin/setup la primera vez que se visita el panel.

# Secreto para firmar las cookies de sesión (admin y galerías con contraseña).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Opcional: tu IP local, para poder abrir la web desde el móvil en la
# misma red durante el desarrollo (next dev). Déjalo vacío si no lo
# necesitas.
ALLOWED_DEV_ORIGIN=""

# URL pública del sitio (absoluta, con https:// en producción): la usan
# las imágenes de Open Graph al compartir un enlace de una galería o de
# la portada.
SITE_URL="http://localhost:3000"

# BETA — opcional: credenciales de una cuenta de servicio de Google
# Cloud (el JSON completo, en una sola línea) para el pie de foto
# automático (Ajustes > Identificación automática). Sin esto, el
# interruptor no hace nada aunque esté activado. Crear en Google Cloud
# Console tras habilitar la Cloud Vision API: APIs y servicios >
# Credenciales > Crear credenciales > Cuenta de servicio > pestaña
# Claves > Crear clave > JSON.
GOOGLE_VISION_CREDENTIALS_JSON=''
